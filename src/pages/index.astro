---
import Layout from '../layouts/Layout.astro';
import AppCard from '../components/AppCard.astro';
import CoreValues from '../components/CoreValues.astro';
import { apps } from '../data/apps';
---

<Layout
  title="Testament Made"
  description="Testament Made LLC builds Harvous, Dinky, and Binky — Scripture study, file compression, and download sorting — with clear principles and contact links."
  preloadImages={apps.map((a) => a.iconSrc)}
>
  <div class="page">
    <main class="main">
      <div class="tm-hero-blobs">
        <div id="tm-bg" class="tm-bg" aria-hidden="true">
          <span class="tm-bg__blob tm-bg__blob--pink"></span>
          <span class="tm-bg__blob tm-bg__blob--indigo"></span>
          <span class="tm-bg__blob tm-bg__blob--blue"></span>
        </div>
        <div class="tm-hero-blobs__foreground">
          <h1 class="heading">
            Apps for studying Scripture, shrinking files, and sorting downloads — made by{' '}
            <span class="author-hit" tabindex="0" role="group" aria-label="Testament Made LLC — Derek Castelli">
              Testament Made LLC.
              <a
                class="about-chip"
                href="https://heyderekj.com/"
                target="_blank"
                rel="noopener noreferrer"
              >
                About Derek Castelli<span class="about-chip__arrow" aria-hidden="true">→</span>
              </a>
            </span>
          </h1>

          <div class="grid">
            {apps.map((app, index) => <AppCard {...app} index={index} />)}
          </div>
        </div>
      </div>

      <CoreValues />

      <div class="toast-slot" id="toast-slot" aria-live="polite" />
    </main>

    <footer class="footer">
      © {new Date().getFullYear()} Testament Made, LLC · <a href="mailto:derek@testamentmade.com">derek@testamentmade.com</a>
    </footer>
  </div>
</Layout>

<style>
  .page {
    position: relative;
    z-index: 1;
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3rem) clamp(1.25rem, 4vw, 2rem) 2rem;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: clamp(2rem, 5vw, 3rem);
    padding: clamp(2.75rem, 10vh, 5rem) 0 2rem;
  }

  .tm-hero-blobs {
    position: relative;
    overflow-x: clip;
    overflow-y: visible;
  }

  .tm-hero-blobs__foreground {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .heading {
    margin: 0 auto;
    max-width: 28ch;
    text-align: center;
    font-weight: 600;
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .nowrap {
    white-space: nowrap;
  }

  /* Hover / focus-within → “About Derek Castelli” chip (pill, like quote affordance) */
  .author-hit {
    position: relative;
    display: inline-block;
    max-width: 100%;
    cursor: default;
    outline: none;
    /* Hover slop: chip sits in this band so the pointer can reach the link without leaving the group */
    padding-bottom: 2.35rem;
    margin-bottom: -2.35rem;
  }

  .about-chip {
    box-sizing: border-box;
    position: absolute;
    left: 50%;
    top: auto;
    bottom: 0.35rem;
    z-index: 30;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem 0.72rem;
    font-size: 0.74rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    background: var(--surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    box-shadow:
      0 2px 6px var(--shadow-soft),
      0 10px 28px var(--shadow-deep);
    transform: translateX(-50%) translateY(6px);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0s linear 0.2s;
  }

  .about-chip:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px var(--focus-ring-gap),
      0 0 0 4px var(--accent),
      0 10px 28px var(--shadow-deep);
  }

  .about-chip:hover {
    border-color: var(--border-strong);
  }

  .about-chip__arrow {
    font-size: 0.92em;
    line-height: 1;
  }

  .author-hit:hover .about-chip,
  .author-hit:focus-within .about-chip {
    visibility: visible;
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0s linear 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .about-chip {
      transition-duration: 0.01ms;
      transition-delay: 0ms !important;
    }
  }

  /* Touch / no-hover: keep link usable without hovering */
  @media (hover: none) {
    .author-hit {
      display: inline;
      padding-bottom: 0;
      margin-bottom: 0;
    }

    .about-chip {
      position: relative;
      left: auto;
      top: auto;
      transform: none;
      margin-left: 0.45em;
      white-space: normal;
      max-width: 12rem;
      text-align: left;
      vertical-align: baseline;
      font-size: 0.7rem;
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      display: inline-flex;
    }

    .about-chip:not(:focus-visible):not(:hover) {
      box-shadow:
        0 1px 3px var(--shadow-soft),
        0 6px 18px var(--shadow-deep);
    }
  }

  /* Bento: 3 equal columns on wide screens; single column on narrow */
  .toast-slot {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    min-height: 0;
  }

  .toast-slot:not(:empty) {
    padding-top: clamp(0.75rem, 3vw, 1.25rem);
  }

  .toast-slot > :global(.tm-toast) {
    flex-shrink: 0;
    position: relative;
    left: auto;
    bottom: auto;
    z-index: 20;
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  @media (min-width: 52rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Easter egg (#8): Binky hover — playful fan-out while messy */
  @media (prefers-reduced-motion: no-preference) {
    .grid.is-messy :global(.app-card) {
      transition:
        transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.28s cubic-bezier(0.22, 1, 0.36, 1),
        border-color 0.28s ease;
    }

    .grid.is-messy :global(.app-card:nth-child(1)) {
      transform: rotate(-3deg) translate(-8px, 6px);
    }

    .grid.is-messy :global(.app-card:nth-child(2)) {
      transform: rotate(2deg) translate(0, -6px);
    }

    .grid.is-messy :global(.app-card:nth-child(3)) {
      transform: rotate(4deg) translate(8px, 4px);
    }

    .grid.is-messy :global(.app-card:nth-child(1):hover),
    .grid.is-messy :global(.app-card:nth-child(1):focus-visible) {
      transform: rotate(-3deg) translate(-8px, 6px) scale(1.02);
    }

    .grid.is-messy :global(.app-card:nth-child(2):hover),
    .grid.is-messy :global(.app-card:nth-child(2):focus-visible) {
      transform: rotate(2deg) translate(0, -6px) scale(1.02);
    }

    .grid.is-messy :global(.app-card:nth-child(3):hover),
    .grid.is-messy :global(.app-card:nth-child(3):focus-visible) {
      transform: rotate(4deg) translate(8px, 4px) scale(1.02);
    }
  }

  .footer {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--footer-border);
    font-size: 13px;
    color: var(--muted);
    text-align: center;
  }

  .footer a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .footer a:hover,
  .footer a:focus-visible {
    color: var(--text);
  }

  .footer a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }
</style>

<script is:inline>
  (function tmHoldingEggs() {
    var mqReduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var dinky = document.querySelector('[data-app="dinky"]');
    var grid = document.querySelector('.grid');
    var toastSlot = document.getElementById('toast-slot');
    var tmBg = document.getElementById('tm-bg');
    var page = document.querySelector('.page');

    function setBgAccent(slug) {
      if (!tmBg) return;
      if (!slug) {
        tmBg.removeAttribute('data-accent');
        return;
      }
      tmBg.setAttribute('data-accent', slug);
    }

    if (grid && tmBg) {
      grid.addEventListener('pointerover', function (e) {
        var card = e.target.closest && e.target.closest('.app-card');
        if (!card || !grid.contains(card)) return;
        setBgAccent(card.getAttribute('data-app'));
      });
      grid.addEventListener('pointerout', function (e) {
        var rel = e.relatedTarget;
        if (rel && grid.contains(rel)) return;
        setBgAccent(null);
      });
      grid.addEventListener('focusin', function (e) {
        var card = e.target.closest && e.target.closest('.app-card');
        if (!card || !grid.contains(card)) return;
        setBgAccent(card.getAttribute('data-app'));
      });
      grid.addEventListener('focusout', function (e) {
        var rel = e.relatedTarget;
        if (rel && grid.contains(rel)) return;
        setBgAccent(null);
      });
    }

    var toastHideTimer = null;

    function fadeOutRemoveToast(el) {
      if (!el || !el.parentNode) return;
      if (toastHideTimer !== null) {
        window.clearTimeout(toastHideTimer);
        toastHideTimer = null;
      }
      el.classList.remove('is-visible');
      window.setTimeout(function () {
        if (el.parentNode) el.remove();
      }, 380);
    }

    function dismissToastImmediately(el) {
      if (toastHideTimer !== null) {
        window.clearTimeout(toastHideTimer);
        toastHideTimer = null;
      }
      if (el && el.parentNode) el.remove();
    }

    function dismissSelectionToastOnly() {
      if (!toastSlot) return;
      var t = toastSlot.querySelector('.tm-toast[data-toast-src="selection"]');
      if (t) dismissToastImmediately(t);
    }

    function showToast(spec) {
      if (!toastSlot) return;
      var prev = toastSlot.querySelector('.tm-toast');
      if (prev) dismissToastImmediately(prev);

      var a = document.createElement('a');
      a.className = 'tm-toast';
      a.href = spec.href;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = spec.message;
      a.setAttribute('role', 'status');
      a.setAttribute('aria-live', 'polite');
      if (spec.source) a.setAttribute('data-toast-src', spec.source);

      toastSlot.appendChild(a);
      window.requestAnimationFrame(function () {
        a.classList.add('is-visible');
      });

      toastHideTimer = window.setTimeout(function () {
        toastHideTimer = null;
        fadeOutRemoveToast(a);
      }, spec.durationMs != null ? spec.durationMs : 4500);

      a.addEventListener('click', function () {
        if (toastHideTimer !== null) {
          window.clearTimeout(toastHideTimer);
          toastHideTimer = null;
        }
      });
    }

    function hasFilePayload(dt) {
      if (!dt || !dt.types) return false;
      for (var i = 0; i < dt.types.length; i++) {
        if (dt.types[i] === 'Files') return true;
      }
      return false;
    }

    if (dinky && toastSlot) {
      document.addEventListener(
        'dragover',
        function (e) {
          if (!hasFilePayload(e.dataTransfer)) return;
          e.preventDefault();
          e.dataTransfer.dropEffect = 'copy';
          var el = document.elementFromPoint(e.clientX, e.clientY);
          if (el && dinky.contains(el)) dinky.classList.add('is-drop-target');
          else dinky.classList.remove('is-drop-target');
        },
        { passive: false },
      );

      document.addEventListener('dragend', function () {
        dinky.classList.remove('is-drop-target');
      });

      document.addEventListener('drop', function (e) {
        dinky.classList.remove('is-drop-target');
        if (!hasFilePayload(e.dataTransfer)) return;
        if (!e.target || !dinky.contains(e.target)) return;
        e.preventDefault();
        var n = e.dataTransfer.files ? e.dataTransfer.files.length : 0;
        if (n <= 0) return;
        showToast({
          message:
            n === 1
              ? 'Want to actually shrink that? Try Dinky — dinkyfiles.com'
              : 'Want to actually shrink those? Try Dinky — dinkyfiles.com',
          href: 'https://dinkyfiles.com/',
          source: 'drop',
          durationMs: 4500,
        });
      });
    }

    var binky = document.querySelector('[data-app="binky"]');
    var messyTimer = 0;
    if (grid && binky && !mqReduce.matches) {
      binky.addEventListener('pointerenter', function () {
        window.clearTimeout(messyTimer);
        grid.classList.add('is-messy');
      });
      binky.addEventListener('pointerleave', function () {
        messyTimer = window.setTimeout(function () {
          grid.classList.remove('is-messy');
        }, 150);
      });
    }

    var selRaf = 0;
    var lastSelectionText = '';

    function selInPage(sel) {
      if (!sel || sel.rangeCount === 0 || !page) return false;
      var node = sel.anchorNode;
      if (!node || node.nodeType === 9) return false;
      return page.contains(node);
    }

    function updateSelectionToast() {
      if (!toastSlot || !page) return;
      var sel = window.getSelection();
      var txt = sel ? sel.toString().trim() : '';
      if (!txt || !sel || !selInPage(sel)) {
        lastSelectionText = '';
        dismissSelectionToastOnly();
        return;
      }
      if (txt === lastSelectionText) return;
      lastSelectionText = txt;

      showToast({
        message: 'Save this in Harvous — harvous.com',
        href: 'https://harvous.com/',
        source: 'selection',
        durationMs: 4500,
      });
    }

    document.addEventListener('selectionchange', function () {
      window.cancelAnimationFrame(selRaf);
      selRaf = window.requestAnimationFrame(updateSelectionToast);
    });

    window.addEventListener(
      'scroll',
      function () {
        lastSelectionText = '';
        dismissSelectionToastOnly();
      },
      true,
    );

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        lastSelectionText = '';
        dismissSelectionToastOnly();
      }
    });
  })();
</script>

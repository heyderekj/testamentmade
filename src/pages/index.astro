---
import Layout from '../layouts/Layout.astro';
import AppCard from '../components/AppCard.astro';
import { apps } from '../data/apps';
---

<Layout
  title="Testament Made"
  description="Testament Made LLC — Dinky, Binky, and Harvous. Contact and product links."
  preloadImages={apps.map((a) => a.iconSrc)}
>
  <div class="page">
    <main class="main">
      <h1 class="heading">
        Apps for shrinking files, sorting downloads, and studying Scripture — made by
        <span class="nowrap">Testament Made LLC.</span>
      </h1>

      <div class="grid">
        {apps.map((app, index) => <AppCard {...app} index={index} />)}
      </div>
    </main>

    <footer class="footer">
      © {new Date().getFullYear()} Testament Made, LLC · <a href="mailto:derek@testamentmade.com">derek@testamentmade.com</a>
    </footer>
  </div>
</Layout>

<style>
  .page {
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1.25rem, 4vw, 2rem) 2rem;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2rem, 5vw, 3rem);
    padding: 2rem 0;
  }

  .heading {
    margin: 0 auto;
    max-width: 28ch;
    text-align: center;
    font-weight: 600;
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .nowrap {
    white-space: nowrap;
  }

  /* Bento: 3 equal columns on wide screens; single column on narrow */
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  @media (min-width: 52rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .footer {
    margin-top: 2.5rem;
    font-size: 13px;
    color: var(--muted);
    text-align: center;
  }

  .footer a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .footer a:hover,
  .footer a:focus-visible {
    color: var(--text);
  }

  .footer a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }
</style>

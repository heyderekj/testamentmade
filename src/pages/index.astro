---
import Layout from '../layouts/Layout.astro';
import AppCard from '../components/AppCard.astro';
import CoreValues from '../components/CoreValues.astro';
import { apps as listedApps } from '../data/apps';
import { sortByLatestCommit } from '../data/sortByLatestCommit';
import { signatureInk, signatureStrokes, signatureViewBox } from '../data/signature';

/** Set to `true` when the core values block should appear again. */
const showCoreValuesSection = false;

/** Most recently worked-on apps first, as of this build. */
const apps = await sortByLatestCommit(listedApps);

/** Pen timing for the signature: a steady speed, with a short lift between strokes. */
const SIGN_SECONDS = 1.5;
const PEN_LIFT = 0.08;
const EASE_IN_OUT = 'cubic-bezier(0.45, 0.05, 0.55, 0.95)';
const EASE_IN = 'cubic-bezier(0.45, 0.05, 1, 1)';
const EASE_OUT = 'cubic-bezier(0, 0, 0.55, 0.95)';
const totalInk = signatureStrokes.reduce((sum, s) => sum + s.length, 0);
let penAt = 0;
const signature = signatureStrokes.map((stroke, i) => {
  const next = signatureStrokes[i + 1];
  if (stroke.join) penAt -= PEN_LIFT; // no lift: carry straight on from the last stroke
  const dur = Math.max(0.12, (stroke.length / totalInk) * SIGN_SECONDS);
  // A joined pair reads as one movement: speed up into the join, ease out of it.
  const ease = stroke.join ? EASE_OUT : next?.join ? EASE_IN : EASE_IN_OUT;
  const timing = { d: stroke.d, delay: penAt.toFixed(3), dur: dur.toFixed(3), ease };
  penAt += dur + PEN_LIFT;
  return timing;
});
---

<Layout
  title="Testament Made"
  description="Small apps, made with care. Testament Made LLC builds Harvous, Here’s My Church, ReviseMy, Dinky, Binky, and Koati (coming soon)."
  preloadImages={apps.slice(0, 3).map((a) => a.iconSrc)}
>
  <div class="page">
    <main class="main">
      <header class="intro">
        <div class="intro__text">
          <h1 class="intro__sub">
            Testament Made is a small independent app studio by <a
              class="intro__me"
              id="about-derek-trigger"
              href="https://heyderekj.com/"
              target="_blank"
              rel="noopener noreferrer"
            ><span class="intro__name">Derek Castelli</span><svg class="intro__sig" viewBox={signatureViewBox} aria-hidden="true" focusable="false">
                <defs>
                  <mask id="signature-ink" maskUnits="userSpaceOnUse" x="0" y="0" width="3262" height="809">
                    {signatureInk.map((d) => <path d={d} fill="#fff" />)}
                  </mask>
                </defs>
                <g mask="url(#signature-ink)">
                  {signature.map((s) => (
                    <path class="intro__stroke" d={s.d} pathLength="1" style={`--delay: ${s.delay}s; --dur: ${s.dur}s; --ease: ${s.ease}`} />
                  ))}
                </g>
              </svg></a>
          </h1>

          <div class="about-card" id="about-derek" role="dialog" aria-label="About Derek Castelli" hidden>
            <div class="about-card__head">
              <img class="about-card__photo" src="/about/derek.jpg" alt="" width="56" height="56" loading="lazy" decoding="async" />
              <div>
                <p class="about-card__name">Derek Castelli</p>
                <p class="about-card__where">Des Moines, Iowa metro</p>
              </div>
            </div>
            <p class="about-card__bio">
              Self-taught designer who’s been making rectangles since 2010. Christian, husband, and always building a side project.
            </p>
            <div class="about-card__links">
              <a href="https://heyderekj.com/" target="_blank" rel="noopener noreferrer">heyderekj.com</a>
              <a href="https://x.com/heyderekj" target="_blank" rel="noopener noreferrer">X.com</a>
              <a href="https://www.linkedin.com/in/heyderekj" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            </div>
          </div>
        </div>
        <div class="showcase__arrows" id="showcase-arrows">
          <button type="button" class="showcase__arrow" id="showcase-prev" aria-controls="showcase-track" aria-label="Previous apps">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
          </button>
          <button type="button" class="showcase__arrow" id="showcase-next" aria-controls="showcase-track" aria-label="Next apps">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
          </button>
        </div>
      </header>

      <section class="showcase" aria-label="Apps by Testament Made">
        <div class="showcase__track" id="showcase-track" tabindex="0">
          {apps.map((app, index) => <AppCard {...app} index={index} />)}
        </div>
      </section>

      {showCoreValuesSection && <CoreValues />}

    </main>

    <footer class="footer">
      © {new Date().getFullYear()} Testament Made, LLC · <a href="mailto:derek@testamentmade.com">derek@testamentmade.com</a>
    </footer>
  </div>
</Layout>

<style>
  .page {
    --page-pad-x: clamp(1rem, 4vw, 3.5rem);
    /* Lines the first card up with the headline, then lets the row run off the right edge. */
    --track-inset: max(var(--page-pad-x), calc((100% - var(--max)) / 2 + var(--page-pad-x)));
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 6vh, 4rem) 0 1.25rem;
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.75rem, 5vh, 3rem);
  }

  .intro {
    width: 100%;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--page-pad-x);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .intro__text {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    max-width: 47.5rem;
  }

  /* The page's one line of copy, set to break over two lines */
  .intro__sub {
    margin: 0;
    max-width: 22em;
    font-size: clamp(1.375rem, 2.4vw, 2rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--muted);
  }

  /* Derek's name: hover writes in his signature; click opens the about card */
  .intro__me {
    position: relative;
    display: inline-block;
    color: var(--text);
    text-decoration: none;
    cursor: pointer;
  }

  .intro__me:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .intro__name {
    transition: opacity 0.2s ease;
  }

  /* Derek's signature, written in stroke by stroke over his name (see data/signature.ts) */
  .intro__sig {
    position: absolute;
    left: 0;
    top: 50%;
    width: 5.6em;
    height: 1.39em; /* the signature's 3262 × 809 shape */
    translate: 0 -52%;
    overflow: visible;
    pointer-events: none;
  }

  .intro__stroke {
    fill: none;
    stroke: currentColor;
    stroke-width: 72; /* just wider than the ink, so it traces each stroke rather than wiping across them */
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }

  @keyframes pen {
    0% {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    0.1% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  @media (hover: hover) {
    .intro__me:hover .intro__name {
      opacity: 0;
    }

    .intro__me:hover .intro__stroke {
      animation: pen var(--dur) var(--ease) var(--delay) both;
    }
  }

  .intro__me.is-open .intro__name {
    opacity: 0;
  }

  /* Once the about card is open the signature stays signed, hover or not */
  .intro__me.is-open .intro__stroke {
    animation: none !important;
    stroke-dashoffset: 0;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__me:hover .intro__stroke {
      animation: none;
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  /* About card: anchored under the sentence, floating over the row */
  .about-card {
    position: absolute;
    top: calc(100% + 14px);
    left: 0;
    z-index: 30;
    width: min(360px, calc(100vw - 2 * var(--page-pad-x)));
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: 24px;
    box-shadow:
      0 2px 8px var(--shadow-soft),
      0 24px 48px -16px var(--shadow-deep);
    opacity: 0;
    translate: 0 -6px;
    scale: 0.98;
    transform-origin: top left;
    transition:
      opacity 0.22s ease,
      translate 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      scale 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-card[hidden] {
    display: flex;
    visibility: hidden;
  }

  .about-card.is-open {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }

  .about-card__head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .about-card__photo {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
  }

  .about-card__name,
  .about-card__where,
  .about-card__bio {
    margin: 0;
  }

  .about-card__name {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .about-card__where {
    font-size: 13px;
    color: var(--muted);
  }

  .about-card__bio {
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-soft);
  }

  .about-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .about-card__links a {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    background: color-mix(in oklch, var(--text) 6%, var(--card-bg));
    color: var(--text);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .about-card__links a:hover {
    background: color-mix(in oklch, var(--text) 11%, var(--card-bg));
  }

  .about-card__links a:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__name,
    .intro__sig,
    .about-card {
      transition: none !important;
    }
  }

  .showcase__arrows {
    display: flex;
    gap: 0.5rem;
  }

  .showcase__arrows[hidden] {
    display: none;
  }

  .showcase__arrow {
    width: 48px;
    height: 48px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: var(--card-bg);
    color: var(--text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .showcase__arrow:hover:not(:disabled) {
    background: var(--text);
    color: var(--bg);
  }

  .showcase__arrow:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }

  .showcase__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .showcase__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    /* A scrolling row clips whatever spills past it, so give the card shadows
       room inside, then pull the row back so the page spacing is unchanged. */
    padding: 32px var(--track-inset) 64px;
    margin-block: -24px -40px;
    scroll-padding-inline: var(--track-inset);
    outline: none;
  }

  .showcase__track::-webkit-scrollbar {
    display: none;
  }

  .showcase__track:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase__track {
      scroll-behavior: auto;
    }
  }

  .footer {
    padding: 0 var(--page-pad-x);
    font-size: 13px;
    color: var(--muted);
    text-align: center;
  }

  .footer a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .footer a:hover,
  .footer a:focus-visible {
    color: var(--text);
  }

  .footer a:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 3px;
    border-radius: 4px;
  }
</style>

<script is:inline>
  (function tmAboutDerek() {
    // Without this script the name is a plain link to heyderekj.com.
    var trigger = document.getElementById('about-derek-trigger');
    var card = document.getElementById('about-derek');
    if (!trigger || !card) return;

    trigger.setAttribute('role', 'button');
    trigger.setAttribute('aria-expanded', 'false');
    trigger.setAttribute('aria-controls', 'about-derek');

    var hideTimer = 0;

    function setOpen(open) {
      window.clearTimeout(hideTimer);
      trigger.classList.toggle('is-open', open);
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) {
        card.hidden = false;
        window.requestAnimationFrame(function () {
          card.classList.add('is-open');
        });
      } else {
        card.classList.remove('is-open');
        hideTimer = window.setTimeout(function () {
          card.hidden = true;
        }, 300);
      }
    }

    trigger.addEventListener('click', function (e) {
      e.preventDefault();
      setOpen(!trigger.classList.contains('is-open'));
    });

    document.addEventListener('click', function (e) {
      if (!trigger.classList.contains('is-open')) return;
      if (card.contains(e.target) || trigger.contains(e.target)) return;
      setOpen(false);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape' || !trigger.classList.contains('is-open')) return;
      setOpen(false);
      trigger.focus();
    });
  })();
</script>

<script is:inline>
  (function tmCards() {
    // Mouse and trackpad: a card opens while hovered; the + pins it open, the × closes it.
    // Touch: the + is the only way to open a card.
    var mqHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    var track = document.getElementById('showcase-track');
    var cards = document.querySelectorAll('.app-card');
    var OPEN_DELAY = 120; // a beat of intent, so sweeping across the row doesn't open every card
    var CLOSE_DELAY = 200; // brushing past the edge shouldn't snap it shut

    // Cards sliding under a still pointer during a scroll aren't a hover. Once the row
    // settles, whichever card is under the pointer gets its hover.
    var scrolling = false;
    var scrollTimer = 0;
    var pointer = null;
    document.addEventListener(
      'pointermove',
      function (e) {
        pointer = e.pointerType === 'mouse' ? { x: e.clientX, y: e.clientY } : null;
      },
      { passive: true },
    );
    if (track) {
      track.addEventListener(
        'scroll',
        function () {
          scrolling = true;
          window.clearTimeout(scrollTimer);
          scrollTimer = window.setTimeout(function () {
            scrolling = false;
            if (!mqHover.matches) return;
            var el = pointer && document.elementFromPoint(pointer.x, pointer.y);
            var under = el && el.closest ? el.closest('.app-card') : null;
            // Browsers don't send "pointer left" when the row scrolls out from under a
            // still mouse, so settle it here: close what slid away, open what slid in.
            for (var c = 0; c < cards.length; c++) {
              if (cards[c] !== under && cards[c].tmUnhover) cards[c].tmUnhover();
            }
            if (under && under.tmHover) under.tmHover();
          }, 140);
        },
        { passive: true },
      );
    }

    for (var i = 0; i < cards.length; i++) {
      (function (card) {
        var toggle = card.querySelector('.app-card__toggle');
        if (!toggle) return;
        var pinned = false;
        var held = false; // closed by hand while hovered: stays shut until the pointer leaves
        var timer = 0;

        function setOpen(open) {
          if (card.classList.contains('is-open') === open) return;
          card.classList.toggle('is-open', open);
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        }

        function later(fn, ms) {
          window.clearTimeout(timer);
          timer = window.setTimeout(fn, ms);
        }

        toggle.addEventListener('click', function () {
          window.clearTimeout(timer);
          var open = !card.classList.contains('is-open');
          pinned = open;
          held = !open;
          setOpen(open);
        });

        var opening = false;

        function hover() {
          if (scrolling || held || pinned) {
            window.clearTimeout(timer);
            opening = false;
            return;
          }
          if (card.classList.contains('is-open')) {
            window.clearTimeout(timer); // back within the close delay: stay open
            return;
          }
          if (opening) return;
          opening = true;
          later(function () {
            opening = false;
            setOpen(true);
          }, OPEN_DELAY);
        }
        card.tmHover = hover;
        card.tmUnhover = function () {
          window.clearTimeout(timer);
          opening = false;
          held = false;
          if (!pinned) setOpen(false);
        };

        card.addEventListener('pointerenter', function (e) {
          if (e.pointerType === 'mouse' && mqHover.matches) hover();
        });

        // A pointer already resting on a card (say, after the arrows moved the row)
        // only needs to nudge it to open.
        card.addEventListener('pointermove', function (e) {
          if (e.pointerType === 'mouse' && mqHover.matches) hover();
        });

        card.addEventListener('pointerleave', function (e) {
          if (e.pointerType !== 'mouse') return;
          held = false;
          opening = false;
          if (pinned) {
            window.clearTimeout(timer);
            return;
          }
          later(function () {
            setOpen(false);
          }, CLOSE_DELAY);
        });
      })(cards[i]);
    }
  })();
</script>

<script is:inline>
  (function tmShowcase() {
    var track = document.getElementById('showcase-track');
    var prev = document.getElementById('showcase-prev');
    var next = document.getElementById('showcase-next');
    var arrows = document.getElementById('showcase-arrows');
    if (!track || !prev || !next || !arrows) return;

    function update() {
      var max = track.scrollWidth - track.clientWidth;
      // Wide enough to show every card: no carousel to drive.
      arrows.hidden = max <= 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
    }

    function step(dir) {
      track.scrollBy({ left: dir * Math.max(320, track.clientWidth * 0.6) });
    }

    prev.addEventListener('click', function () {
      step(-1);
    });
    next.addEventListener('click', function () {
      step(1);
    });

    track.addEventListener('keydown', function (e) {
      if (e.target !== track) return;
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        step(-1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        step(1);
      }
    });

    var raf = 0;
    track.addEventListener(
      'scroll',
      function () {
        window.cancelAnimationFrame(raf);
        raf = window.requestAnimationFrame(update);
      },
      { passive: true },
    );
    window.addEventListener('resize', update);
    window.addEventListener('load', update);
    update();
  })();
</script>


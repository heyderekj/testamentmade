---
import Layout from '../layouts/Layout.astro';
import AppCard from '../components/AppCard.astro';
import CoreValues from '../components/CoreValues.astro';
import { apps } from '../data/apps';
---

<Layout
  title="Testament Made"
  description="Testament Made LLC builds Harvous, Dinky, and Binky — apps to take notes, shrink files, and sort downloads — with clear principles and contact links."
  preloadImages={apps.map((a) => a.iconSrc)}
>
  <div class="page">
    <main class="main">
      <div class="tm-hero-blobs">
        <div id="tm-bg" class="tm-bg" aria-hidden="true">
          <span class="tm-bg__blob tm-bg__blob--pink"></span>
          <span class="tm-bg__blob tm-bg__blob--indigo"></span>
          <span class="tm-bg__blob tm-bg__blob--blue"></span>
        </div>
        <div class="tm-hero-blobs__foreground">
          <h1 class="heading">
            <span class="heading__lead">Apps to take notes, shrink files, and sort downloads.</span>
            <span class="heading__tail">
              Made by{' '}
              <span class="author-hit" tabindex="0" role="group" aria-label="Testament Made LLC, Derek Castelli">
                Testament Made LLC.
                <a
                  class="about-chip"
                  href="https://heyderekj.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  About Derek Castelli<span class="about-chip__arrow" aria-hidden="true">→</span>
                </a>
              </span>
            </span>
          </h1>

          <section class="app-showcase grid" aria-label="Apps by Testament Made">
            <div class="app-showcase__viewport" id="app-showcase-viewport" tabindex="0">
              {apps.map((app, index) => (
                <div class="app-showcase__slide">
                  <AppCard {...app} index={index} />
                </div>
              ))}
            </div>
            <div class="app-showcase__controls" id="app-showcase-controls">
              <button
                type="button"
                class="app-showcase__arrow app-showcase__arrow--prev"
                id="app-showcase-prev"
                aria-controls="app-showcase-viewport"
                aria-label="Previous app"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
              </button>
              <div class="app-showcase__dots" role="group" aria-label="Choose app to show">
                {apps.map((app, i) => (
                  <button
                    type="button"
                    class:list={['app-showcase__dot', { 'is-active': i === 0 }]}
                    data-slide-to={String(i)}
                    aria-label={`Show ${app.title}`}
                    aria-current={i === 0 ? 'true' : undefined}
                  />
                ))}
              </div>
              <button
                type="button"
                class="app-showcase__arrow app-showcase__arrow--next"
                id="app-showcase-next"
                aria-controls="app-showcase-viewport"
                aria-label="Next app"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
              </button>
            </div>
          </section>
        </div>
      </div>

      <CoreValues />

      <div class="toast-slot" id="toast-slot" aria-live="polite" />
    </main>

    <footer class="footer">
      © {new Date().getFullYear()} Testament Made, LLC · <a href="mailto:derek@testamentmade.com">derek@testamentmade.com</a>
    </footer>
  </div>
</Layout>

<style>
  .page {
    --page-pad-x: clamp(1.25rem, 4vw, 2rem);
    position: relative;
    z-index: 1;
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 2.5rem) var(--page-pad-x) 2rem;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: clamp(2rem, 5vw, 3rem);
    padding: 2rem 0;
  }

  .tm-hero-blobs {
    position: relative;
    /* Match .page horizontal padding — avoids 100vw scrollbar overflow */
    width: calc(100% + 2 * var(--page-pad-x));
    margin-left: calc(-1 * var(--page-pad-x));
    margin-right: calc(-1 * var(--page-pad-x));
    max-width: none;
  }

  .tm-hero-blobs .tm-bg {
    /* Temporarily hidden — remove this rule to restore orbs */
    display: none;
  }

  .tm-hero-blobs__foreground {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3rem);
    /* Re-inset heading + cards: parent bleeds for orbs, content keeps page gutters */
    padding-left: var(--page-pad-x);
    padding-right: var(--page-pad-x);
  }

  .heading {
    margin: 0 auto;
    max-width: 28ch;
    text-align: center;
    font-weight: 600;
    font-size: clamp(1.625rem, 3.25vw + 0.35rem, 2.35rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
    text-wrap: pretty;
  }

  @media (min-width: 52rem) {
    .heading {
      max-width: min(44ch, 100%);
    }

    .heading__lead {
      display: block;
    }

    .heading__tail {
      display: block;
    }
  }

  .nowrap {
    white-space: nowrap;
  }

  /* Hover / focus-within → “About Derek Castelli” chip (pill, like quote affordance) */
  .author-hit {
    position: relative;
    display: inline-block;
    max-width: 100%;
    cursor: default;
    outline: none;
    /* Hover slop: chip sits in this band so the pointer can reach the link without leaving the group */
    padding-bottom: 2.35rem;
    margin-bottom: -2.35rem;
  }

  .about-chip {
    box-sizing: border-box;
    position: absolute;
    left: 50%;
    top: auto;
    bottom: 0.35rem;
    z-index: 30;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem 0.72rem;
    font-size: 0.74rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    background: var(--surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    box-shadow:
      0 2px 6px var(--shadow-soft),
      0 10px 28px var(--shadow-deep);
    transform: translateX(-50%) translateY(6px);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0s linear 0.2s;
  }

  .about-chip:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px var(--focus-ring-gap),
      0 0 0 4px var(--accent),
      0 10px 28px var(--shadow-deep);
  }

  .about-chip:hover {
    border-color: var(--border-strong);
  }

  .about-chip__arrow {
    font-size: 0.92em;
    line-height: 1;
  }

  .author-hit:hover .about-chip,
  .author-hit:focus-within .about-chip {
    visibility: visible;
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0s linear 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .about-chip {
      transition-duration: 0.01ms;
      transition-delay: 0ms !important;
    }
  }

  /* Touch / no-hover: keep link usable without hovering */
  @media (hover: none) {
    .author-hit {
      display: inline;
      padding-bottom: 0;
      margin-bottom: 0;
    }

    .about-chip {
      position: relative;
      left: auto;
      top: auto;
      transform: none;
      margin-left: 0.45em;
      white-space: normal;
      max-width: 12rem;
      text-align: left;
      vertical-align: baseline;
      font-size: 0.7rem;
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      display: inline-flex;
    }

    .about-chip:not(:focus-visible):not(:hover) {
      box-shadow:
        0 1px 3px var(--shadow-soft),
        0 6px 18px var(--shadow-deep);
    }
  }

  /* App cards: horizontal carousel below 52rem; 3-column grid from 52rem up */
  .app-showcase {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .app-showcase__viewport {
    width: 100%;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: clamp(1rem, 3.5vw, 1.5rem);
    align-items: stretch;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    outline: none;
    min-height: 0;
  }

  .app-showcase__viewport::-webkit-scrollbar {
    display: none;
  }

  .app-showcase__viewport:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 0.75rem;
  }

  .app-showcase__slide {
    min-width: 0;
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .app-showcase__slide :global(.app-card) {
    flex: 1;
    min-height: 100%;
  }

  .app-showcase__controls {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .app-showcase__arrow {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border-radius: 999px;
    border: 1px solid var(--border-subtle);
    background: var(--surface-elevated);
    color: var(--text);
    box-shadow: 0 1px 2px var(--shadow-soft);
    cursor: pointer;
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease,
      box-shadow 0.2s ease;
  }

  .app-showcase__arrow:hover {
    border-color: var(--border-strong);
    box-shadow: 0 2px 8px var(--shadow-soft);
  }

  .app-showcase__arrow:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .app-showcase__arrow:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    box-shadow: none;
  }

  .app-showcase__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
  }

  .app-showcase__dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: color-mix(in oklch, var(--muted) 45%, transparent);
    cursor: pointer;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      width 0.2s ease;
  }

  .app-showcase__dot.is-active {
    width: 1.35rem;
    background: var(--accent);
  }

  .app-showcase__dot:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (min-width: 52rem) {
    .app-showcase {
      gap: 0;
    }

    .app-showcase__viewport {
      display: grid;
      grid-auto-flow: row;
      grid-auto-columns: unset;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      overflow-x: visible;
      overflow-y: visible;
      scroll-snap-type: none;
      scroll-behavior: auto;
    }

    .app-showcase__slide {
      display: contents;
      scroll-snap-align: unset;
      scroll-snap-stop: normal;
    }

    .app-showcase__controls {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-showcase__viewport {
      scroll-behavior: auto;
    }
  }

  .toast-slot {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    min-height: 0;
  }

  .toast-slot:not(:empty) {
    padding-top: clamp(0.75rem, 3vw, 1.25rem);
  }

  .toast-slot > :global(.tm-toast) {
    flex-shrink: 0;
    position: relative;
    left: auto;
    bottom: auto;
    z-index: 20;
    margin: 0;
  }

  /* Easter egg (#8): Binky hover — playful fan-out while messy */
  @media (prefers-reduced-motion: no-preference) {
    .grid.is-messy :global(.app-card) {
      transition:
        transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.28s cubic-bezier(0.22, 1, 0.36, 1),
        border-color 0.28s ease;
    }

    .grid.is-messy :global(.app-showcase__slide:nth-child(1) .app-card) {
      transform: rotate(-3deg) translate(-8px, 6px);
    }

    .grid.is-messy :global(.app-showcase__slide:nth-child(2) .app-card) {
      transform: rotate(2deg) translate(0, -6px);
    }

    .grid.is-messy :global(.app-showcase__slide:nth-child(3) .app-card) {
      transform: rotate(4deg) translate(8px, 4px);
    }

    .grid.is-messy :global(.app-showcase__slide:nth-child(1) .app-card:hover),
    .grid.is-messy :global(.app-showcase__slide:nth-child(1) .app-card:focus-visible) {
      transform: rotate(-3deg) translate(-8px, 6px) scale(1.02);
    }

    .grid.is-messy :global(.app-showcase__slide:nth-child(2) .app-card:hover),
    .grid.is-messy :global(.app-showcase__slide:nth-child(2) .app-card:focus-visible) {
      transform: rotate(2deg) translate(0, -6px) scale(1.02);
    }

    .grid.is-messy :global(.app-showcase__slide:nth-child(3) .app-card:hover),
    .grid.is-messy :global(.app-showcase__slide:nth-child(3) .app-card:focus-visible) {
      transform: rotate(4deg) translate(8px, 4px) scale(1.02);
    }
  }

  .footer {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--footer-border);
    font-size: 13px;
    color: var(--muted);
    text-align: center;
  }

  .footer a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .footer a:hover,
  .footer a:focus-visible {
    color: var(--text);
  }

  .footer a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }
</style>

<script is:inline>
  (function tmHoldingEggs() {
    var mqReduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var dinky = document.querySelector('[data-app="dinky"]');
    var grid = document.querySelector('.grid');
    var toastSlot = document.getElementById('toast-slot');
    var tmBg = document.getElementById('tm-bg');
    var page = document.querySelector('.page');

    function setBgAccent(slug) {
      if (!tmBg) return;
      if (!slug) {
        tmBg.removeAttribute('data-accent');
        return;
      }
      tmBg.setAttribute('data-accent', slug);
    }

    if (grid && tmBg) {
      grid.addEventListener('pointerover', function (e) {
        var card = e.target.closest && e.target.closest('.app-card');
        if (!card || !grid.contains(card)) return;
        setBgAccent(card.getAttribute('data-app'));
      });
      grid.addEventListener('pointerout', function (e) {
        var rel = e.relatedTarget;
        if (rel && grid.contains(rel)) return;
        setBgAccent(null);
      });
      grid.addEventListener('focusin', function (e) {
        var card = e.target.closest && e.target.closest('.app-card');
        if (!card || !grid.contains(card)) return;
        setBgAccent(card.getAttribute('data-app'));
      });
      grid.addEventListener('focusout', function (e) {
        var rel = e.relatedTarget;
        if (rel && grid.contains(rel)) return;
        setBgAccent(null);
      });
    }

    var toastHideTimer = null;

    function fadeOutRemoveToast(el) {
      if (!el || !el.parentNode) return;
      if (toastHideTimer !== null) {
        window.clearTimeout(toastHideTimer);
        toastHideTimer = null;
      }
      el.classList.remove('is-visible');
      window.setTimeout(function () {
        if (el.parentNode) el.remove();
      }, 380);
    }

    function dismissToastImmediately(el) {
      if (toastHideTimer !== null) {
        window.clearTimeout(toastHideTimer);
        toastHideTimer = null;
      }
      if (el && el.parentNode) el.remove();
    }

    function dismissSelectionToastOnly() {
      if (!toastSlot) return;
      var t = toastSlot.querySelector('.tm-toast[data-toast-src="selection"]');
      if (t) dismissToastImmediately(t);
    }

    function showToast(spec) {
      if (!toastSlot) return;
      var prev = toastSlot.querySelector('.tm-toast');
      if (prev) dismissToastImmediately(prev);

      var a = document.createElement('a');
      a.className = 'tm-toast';
      a.href = spec.href;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = spec.message;
      a.setAttribute('role', 'status');
      a.setAttribute('aria-live', 'polite');
      if (spec.source) a.setAttribute('data-toast-src', spec.source);

      toastSlot.appendChild(a);
      window.requestAnimationFrame(function () {
        a.classList.add('is-visible');
      });

      toastHideTimer = window.setTimeout(function () {
        toastHideTimer = null;
        fadeOutRemoveToast(a);
      }, spec.durationMs != null ? spec.durationMs : 4500);

      a.addEventListener('click', function () {
        if (toastHideTimer !== null) {
          window.clearTimeout(toastHideTimer);
          toastHideTimer = null;
        }
      });
    }

    function hasFilePayload(dt) {
      if (!dt || !dt.types) return false;
      for (var i = 0; i < dt.types.length; i++) {
        if (dt.types[i] === 'Files') return true;
      }
      return false;
    }

    if (dinky && toastSlot) {
      document.addEventListener(
        'dragover',
        function (e) {
          if (!hasFilePayload(e.dataTransfer)) return;
          e.preventDefault();
          e.dataTransfer.dropEffect = 'copy';
          var el = document.elementFromPoint(e.clientX, e.clientY);
          if (el && dinky.contains(el)) dinky.classList.add('is-drop-target');
          else dinky.classList.remove('is-drop-target');
        },
        { passive: false },
      );

      document.addEventListener('dragend', function () {
        dinky.classList.remove('is-drop-target');
      });

      document.addEventListener('drop', function (e) {
        dinky.classList.remove('is-drop-target');
        if (!hasFilePayload(e.dataTransfer)) return;
        if (!e.target || !dinky.contains(e.target)) return;
        e.preventDefault();
        var n = e.dataTransfer.files ? e.dataTransfer.files.length : 0;
        if (n <= 0) return;
        showToast({
          message:
            n === 1
              ? 'Want to actually shrink that? Try Dinky — dinkyfiles.com'
              : 'Want to actually shrink those? Try Dinky — dinkyfiles.com',
          href: 'https://dinkyfiles.com/',
          source: 'drop',
          durationMs: 4500,
        });
      });
    }

    var binky = document.querySelector('[data-app="binky"]');
    var messyTimer = 0;
    if (grid && binky && !mqReduce.matches) {
      binky.addEventListener('pointerenter', function () {
        window.clearTimeout(messyTimer);
        grid.classList.add('is-messy');
      });
      binky.addEventListener('pointerleave', function () {
        messyTimer = window.setTimeout(function () {
          grid.classList.remove('is-messy');
        }, 150);
      });
    }

    var selRaf = 0;
    var lastSelectionText = '';

    function selInPage(sel) {
      if (!sel || sel.rangeCount === 0 || !page) return false;
      var node = sel.anchorNode;
      if (!node || node.nodeType === 9) return false;
      return page.contains(node);
    }

    function updateSelectionToast() {
      if (!toastSlot || !page) return;
      var sel = window.getSelection();
      var txt = sel ? sel.toString().trim() : '';
      if (!txt || !sel || !selInPage(sel)) {
        lastSelectionText = '';
        dismissSelectionToastOnly();
        return;
      }
      if (txt === lastSelectionText) return;
      lastSelectionText = txt;

      showToast({
        message: 'Save this in Harvous — harvous.com',
        href: 'https://harvous.com/',
        source: 'selection',
        durationMs: 4500,
      });
    }

    document.addEventListener('selectionchange', function () {
      window.cancelAnimationFrame(selRaf);
      selRaf = window.requestAnimationFrame(updateSelectionToast);
    });

    window.addEventListener(
      'scroll',
      function () {
        lastSelectionText = '';
        dismissSelectionToastOnly();
      },
      true,
    );

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        lastSelectionText = '';
        dismissSelectionToastOnly();
      }
    });
  })();
</script>

<script is:inline>
  (function tmAppCarousel() {
    var mqCarousel = window.matchMedia('(max-width: 51.99rem)');
    var mqReduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var viewport = document.getElementById('app-showcase-viewport');
    var prevBtn = document.getElementById('app-showcase-prev');
    var nextBtn = document.getElementById('app-showcase-next');
    var showcase = document.querySelector('.app-showcase');
    if (!viewport || !prevBtn || !nextBtn || !showcase) return;

    function slides() {
      return viewport.querySelectorAll('.app-showcase__slide');
    }

    function nearestIndex() {
      var list = slides();
      if (!list.length) return 0;
      var x = viewport.scrollLeft;
      var best = 0;
      var bestDist = Infinity;
      for (var i = 0; i < list.length; i++) {
        var d = Math.abs(list[i].offsetLeft - x);
        if (d < bestDist) {
          bestDist = d;
          best = i;
        }
      }
      return best;
    }

    function scrollToIndex(i, smooth) {
      var list = slides();
      if (!list.length) return;
      var clamped = Math.max(0, Math.min(list.length - 1, i));
      var el = list[clamped];
      var useSmooth = smooth !== false && !mqReduce.matches;
      viewport.scrollTo({
        left: el.offsetLeft,
        behavior: useSmooth ? 'smooth' : 'auto',
      });
    }

    function updateUI() {
      if (!mqCarousel.matches) return;
      var idx = nearestIndex();
      var list = slides();
      var last = list.length - 1;
      prevBtn.disabled = idx <= 0;
      nextBtn.disabled = idx >= last;
      var dots = showcase.querySelectorAll('.app-showcase__dot');
      for (var d = 0; d < dots.length; d++) {
        var on = d === idx;
        dots[d].classList.toggle('is-active', on);
        if (on) dots[d].setAttribute('aria-current', 'true');
        else dots[d].removeAttribute('aria-current');
      }
    }

    var autoTimer = null;

    function stopAuto() {
      if (autoTimer !== null) {
        window.clearInterval(autoTimer);
        autoTimer = null;
      }
    }

    function startAuto() {
      stopAuto();
      if (!mqCarousel.matches || mqReduce.matches) return;
      autoTimer = window.setInterval(function () {
        var list = slides();
        if (list.length < 2) return;
        var idx = nearestIndex();
        var next = (idx + 1) % list.length;
        scrollToIndex(next, true);
      }, 6000);
    }

    var scrollIdle = null;
    function onScroll() {
      window.requestAnimationFrame(updateUI);
      if (scrollIdle !== null) window.clearTimeout(scrollIdle);
      scrollIdle = window.setTimeout(function () {
        scrollIdle = null;
        updateUI();
      }, 100);
    }

    prevBtn.addEventListener('click', function () {
      scrollToIndex(nearestIndex() - 1, true);
    });
    nextBtn.addEventListener('click', function () {
      scrollToIndex(nearestIndex() + 1, true);
    });

    var dots = showcase.querySelectorAll('.app-showcase__dot');
    for (var i = 0; i < dots.length; i++) {
      dots[i].addEventListener('click', (function (slide) {
        return function () {
          scrollToIndex(slide, true);
        };
      })(i));
    }

    viewport.addEventListener('scroll', onScroll, { passive: true });
    viewport.addEventListener('scrollend', updateUI);

    showcase.addEventListener('pointerenter', stopAuto);
    showcase.addEventListener('pointerleave', function (e) {
      if (e.relatedTarget && showcase.contains(e.relatedTarget)) return;
      if (mqCarousel.matches) startAuto();
    });

    viewport.addEventListener('keydown', function (e) {
      if (!mqCarousel.matches) return;
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        scrollToIndex(nearestIndex() - 1, true);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        scrollToIndex(nearestIndex() + 1, true);
      }
    });

    function onMqChange() {
      stopAuto();
      if (!mqCarousel.matches) {
        viewport.scrollLeft = 0;
      } else {
        window.requestAnimationFrame(function () {
          updateUI();
          startAuto();
        });
      }
      updateUI();
    }

    if (typeof mqCarousel.addEventListener === 'function') {
      mqCarousel.addEventListener('change', onMqChange);
    } else {
      mqCarousel.addListener(onMqChange);
    }

    window.addEventListener('load', function () {
      updateUI();
      if (mqCarousel.matches) startAuto();
    });
    updateUI();
    if (mqCarousel.matches) startAuto();
  })();
</script>

---
import Layout from '../layouts/Layout.astro';
import AppCard from '../components/AppCard.astro';
import CoreValues from '../components/CoreValues.astro';
import { apps } from '../data/apps';
---

<Layout
  title="Testament Made"
  description="Testament Made LLC builds Harvous, Dinky, and Binky — apps to take notes, shrink files, and sort downloads — with clear principles and contact links."
  preloadImages={apps.map((a) => a.iconSrc)}
>
  <div class="page">
    <main class="main">
      <div class="tm-hero-blobs">
        <div id="tm-bg" class="tm-bg" aria-hidden="true">
          <span class="tm-bg__blob tm-bg__blob--pink"></span>
          <span class="tm-bg__blob tm-bg__blob--indigo"></span>
          <span class="tm-bg__blob tm-bg__blob--blue"></span>
        </div>
        <div class="tm-hero-blobs__foreground">
          <h1 class="heading">
            <span class="heading__lead">Take notes, shrink files, and sort downloads.</span>{' '}
            <span class="heading__tail">
              Apps by{' '}
              <span
                class="author-hit"
                id="author-hit"
                tabindex="0"
                role="group"
                aria-label="Testament Made LLC, Derek Castelli"
                aria-expanded="false"
                aria-controls="about-derek-chip"
              >
                <span class="author-hit__name">Testament Made LLC.</span>
                <a
                  class="about-chip"
                  id="about-derek-chip"
                  href="https://heyderekj.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  About Derek Castelli<span class="about-chip__arrow" aria-hidden="true">→</span>
                </a>
              </span>
            </span>
          </h1>

          <section class="app-showcase grid" aria-label="Apps by Testament Made">
            <div class="app-showcase__viewport" id="app-showcase-viewport" tabindex="0">
              {apps.map((app, index) => (
                <div class="app-showcase__slide">
                  <AppCard {...app} index={index} />
                </div>
              ))}
            </div>
            <div class="app-showcase__controls" id="app-showcase-controls">
              <button
                type="button"
                class="app-showcase__arrow app-showcase__arrow--prev"
                id="app-showcase-prev"
                aria-controls="app-showcase-viewport"
                aria-label="Previous app"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
              </button>
              <div class="app-showcase__dots" role="group" aria-label="Choose app to show">
                {apps.map((app, i) => (
                  <button
                    type="button"
                    class:list={['app-showcase__dot', { 'is-active': i === 0 }]}
                    data-slide-to={String(i)}
                    aria-label={`Show ${app.title}`}
                    aria-current={i === 0 ? 'true' : undefined}
                  >
                    <span class="app-showcase__dot-progress" aria-hidden="true" />
                  </button>
                ))}
              </div>
              <button
                type="button"
                class="app-showcase__arrow app-showcase__arrow--next"
                id="app-showcase-next"
                aria-controls="app-showcase-viewport"
                aria-label="Next app"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
              </button>
            </div>
          </section>
        </div>
      </div>

      <CoreValues />

      <div class="toast-slot" id="toast-slot" aria-live="polite" />
    </main>

    <footer class="footer">
      © {new Date().getFullYear()} Testament Made, LLC · <a href="mailto:derek@testamentmade.com">derek@testamentmade.com</a>
    </footer>
  </div>
</Layout>

<style>
  .page {
    --page-pad-x: clamp(1.25rem, 4vw, 2rem);
    position: relative;
    z-index: 1;
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 2.5rem) var(--page-pad-x) 2rem;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: clamp(2rem, 5vw, 3rem);
    padding: 2rem 0 0;
  }

  .tm-hero-blobs {
    position: relative;
    /* Match .page horizontal padding — avoids 100vw scrollbar overflow */
    width: calc(100% + 2 * var(--page-pad-x));
    margin-left: calc(-1 * var(--page-pad-x));
    margin-right: calc(-1 * var(--page-pad-x));
    max-width: none;
  }

  .tm-hero-blobs .tm-bg {
    /* Temporarily hidden — remove this rule to restore orbs */
    display: none;
  }

  .tm-hero-blobs__foreground {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3rem);
    /* Re-inset heading + cards: parent bleeds for orbs, content keeps page gutters */
    padding-left: var(--page-pad-x);
    padding-right: var(--page-pad-x);
  }

  .heading {
    margin: 0 auto;
    max-width: 28ch;
    text-align: center;
    font-weight: 600;
    font-size: clamp(1.75rem, 3.65vw + 0.45rem, 2.7rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
    text-wrap: pretty;
  }

  .heading__lead,
  .heading__tail {
    display: inline;
  }

  @media (max-width: 51.99rem) {
    .heading {
      font-size: clamp(0.68rem, 2.1vw + 0.26rem, 1.45rem);
      max-width: 100%;
      line-height: 1.22;
      text-wrap: wrap;
      letter-spacing: -0.028em;
    }

    .heading__lead,
    .heading__tail {
      display: block;
    }

    /* One line for the first sentence so “Apps by …” begins line 2 */
    .heading__lead {
      white-space: nowrap;
    }

    .heading__tail {
      margin-top: 0.14em;
      white-space: normal;
    }
  }

  @media (max-width: 22.5rem) {
    .heading {
      font-size: clamp(0.64rem, 1.95vw + 0.22rem, 1.32rem);
    }
  }

  @media (min-width: 52rem) {
    .tm-hero-blobs__foreground {
      padding-top: clamp(2.5rem, 8vh, 6rem);
    }

    .heading {
      max-width: min(48ch, 100%);
    }

    .heading__lead,
    .heading__tail {
      display: block;
    }
  }

  .nowrap {
    white-space: nowrap;
  }

  /* Hover / focus-within → “About Derek Castelli” chip (pill, like quote affordance) */
  .author-hit {
    position: relative;
    display: inline-block;
    max-width: 100%;
    cursor: default;
    outline: none;
    /* Hover slop: chip sits in this band so the pointer can reach the link without leaving the group */
    padding-bottom: 2.35rem;
    margin-bottom: -2.35rem;
  }

  .about-chip {
    box-sizing: border-box;
    position: absolute;
    left: 50%;
    top: auto;
    bottom: 0.35rem;
    z-index: 30;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem 0.72rem;
    font-size: 0.74rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    background: var(--surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    box-shadow:
      0 2px 6px var(--shadow-soft),
      0 10px 28px var(--shadow-deep);
    transform: translateX(-50%) translateY(6px);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0s linear 0.2s;
  }

  .about-chip:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px var(--focus-ring-gap),
      0 0 0 4px var(--accent),
      0 10px 28px var(--shadow-deep);
  }

  .about-chip:hover {
    border-color: var(--border-strong);
  }

  .about-chip__arrow {
    font-size: 0.92em;
    line-height: 1;
  }

  @media (hover: hover) {
    .author-hit:hover .about-chip,
    .author-hit:focus-within .about-chip {
      visibility: visible;
      opacity: 1;
      transform: translateX(-50%) translateY(0);
      pointer-events: auto;
      transition:
        opacity 0.2s ease,
        transform 0.2s ease,
        visibility 0s linear 0s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-chip {
      transition-duration: 0.01ms;
      transition-delay: 0ms !important;
    }
  }

  /* Touch / coarse pointer: chip opens on tap of company name (see tmAuthorHitTouch) */
  @media (hover: none) {
    .author-hit {
      padding-bottom: 0;
      margin-bottom: 0;
    }

    .author-hit__name {
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.14em;
      text-decoration-color: color-mix(in oklch, currentColor 32%, transparent);
    }

    .about-chip {
      top: 100%;
      bottom: auto;
      margin-top: 0.35rem;
      transform: translateX(-50%) translateY(4px);
      max-width: min(12rem, calc(100vw - 2.5rem));
    }

    .author-hit.is-about-open .about-chip,
    .author-hit:focus-within .about-chip {
      visibility: visible;
      opacity: 1;
      transform: translateX(-50%) translateY(0);
      pointer-events: auto;
      transition:
        opacity 0.2s ease,
        transform 0.2s ease,
        visibility 0s linear 0s;
    }
  }

  /* App cards: horizontal carousel below 52rem; 3-column grid from 52rem up */
  .app-showcase {
    --carousel-autoplay-ms: 6000ms;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .app-showcase__viewport {
    width: 100%;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: clamp(1rem, 3.5vw, 1.5rem);
    align-items: stretch;
    overflow-x: auto;
    overflow-y: visible;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    outline: none;
    min-height: 0;
  }

  .app-showcase__viewport::-webkit-scrollbar {
    display: none;
  }

  /* Room for card box-shadow + icon drop-shadow inside scrollport (carousel only). */
  @media (max-width: 51.99rem) {
    .app-showcase {
      gap: clamp(0.25rem, 1.75vw, 0.625rem);
    }

    .app-showcase__viewport {
      align-items: start;
      flex-shrink: 0;
      min-height: auto;
      padding-top: clamp(1.25rem, 4.5vw, 2.25rem);
      padding-bottom: clamp(1.35rem, 5vw, 2.25rem);
      padding-inline: clamp(1rem, 5vw, 1.75rem);
      scroll-padding-inline: clamp(1rem, 5vw, 1.75rem);
    }

    /* Inset cards so shadow paints inside the slide box (viewport overflow-x won't clip). */
    .app-showcase__slide {
      box-sizing: border-box;
      padding-inline: clamp(0.75rem, 3.25vw, 1.25rem);
      padding-top: clamp(0.85rem, 3.25vw, 1.5rem);
      padding-bottom: clamp(1.5rem, 6vw, 2.75rem);
    }

    /* Natural card height so bottom shadow + icon glow aren’t flush with the slide edge. */
    .app-showcase__slide :global(.app-card) {
      flex: 0 1 auto;
      min-height: 0;
    }
  }

  .app-showcase__viewport:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 0.75rem;
  }

  .app-showcase__slide {
    min-width: 0;
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .app-showcase__slide :global(.app-card) {
    flex: 1;
    min-height: 100%;
  }

  .app-showcase__controls {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .app-showcase__arrow {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border-radius: 999px;
    border: 1px solid var(--border-subtle);
    background: var(--surface-elevated);
    color: var(--text);
    box-shadow: 0 1px 2px var(--shadow-soft);
    cursor: pointer;
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease,
      box-shadow 0.2s ease;
  }

  .app-showcase__arrow:hover {
    border-color: var(--border-strong);
    box-shadow: 0 2px 8px var(--shadow-soft);
  }

  .app-showcase__arrow:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .app-showcase__arrow:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    box-shadow: none;
  }

  .app-showcase__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
  }

  .app-showcase__dot {
    position: relative;
    box-sizing: border-box;
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: color-mix(in oklch, var(--muted) 45%, transparent);
    cursor: pointer;
    flex-shrink: 0;
    transition:
      width 0.2s ease,
      height 0.2s ease,
      background 0.2s ease;
  }

  .app-showcase__dot-progress {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: left center;
    opacity: 0;
    /* Same as core-values titles / feature icons (--dinky-text → --text) */
    background: var(--text);
  }

  .app-showcase__dot.is-active {
    width: 1.35rem;
    height: 0.5rem;
    background: color-mix(in oklch, var(--muted) 28%, var(--card-bg));
  }

  .app-showcase__dot:not(.is-active) .app-showcase__dot-progress {
    opacity: 0;
    animation: none !important;
    transform: scaleX(0);
  }

  .app-showcase__dot.is-active .app-showcase__dot-progress {
    opacity: 1;
    animation: app-showcase-dot-progress var(--carousel-autoplay-ms, 6000ms) linear forwards;
  }

  .app-showcase--carousel-paused .app-showcase__dot.is-active .app-showcase__dot-progress {
    animation-play-state: paused;
  }

  .app-showcase__dot:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @keyframes app-showcase-dot-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-showcase__dot.is-active .app-showcase__dot-progress {
      animation: none;
      transform: scaleX(1);
    }
  }

  @media (min-width: 52rem) {
    .app-showcase {
      gap: 0;
    }

    .app-showcase__viewport {
      display: grid;
      grid-auto-flow: row;
      grid-auto-columns: unset;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      overflow-x: visible;
      overflow-y: visible;
      scroll-snap-type: none;
      scroll-behavior: auto;
    }

    .app-showcase__slide {
      display: contents;
      scroll-snap-align: unset;
      scroll-snap-stop: normal;
    }

    .app-showcase__controls {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-showcase__viewport {
      scroll-behavior: auto;
    }
  }

  .toast-slot {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    min-height: 0;
  }

  .toast-slot:not(:empty) {
    padding-top: clamp(0.75rem, 3vw, 1.25rem);
  }

  .toast-slot > :global(.tm-toast) {
    flex-shrink: 0;
    position: relative;
    left: auto;
    bottom: auto;
    z-index: 20;
    margin: 0;
  }

  /* Easter egg (#8): Binky hover — playful fan-out while messy */
  @media (prefers-reduced-motion: no-preference) {
    .grid.is-messy :global(.app-card) {
      transition:
        transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.28s cubic-bezier(0.22, 1, 0.36, 1),
        border-color 0.28s ease;
    }

    .grid.is-messy :global(.app-showcase__slide:nth-child(1) .app-card) {
      transform: rotate(-3deg) translate(-8px, 6px);
    }

    .grid.is-messy :global(.app-showcase__slide:nth-child(2) .app-card) {
      transform: rotate(2deg) translate(0, -6px);
    }

    .grid.is-messy :global(.app-showcase__slide:nth-child(3) .app-card) {
      transform: rotate(4deg) translate(8px, 4px);
    }

    .grid.is-messy :global(.app-showcase__slide:nth-child(1) .app-card:hover),
    .grid.is-messy :global(.app-showcase__slide:nth-child(1) .app-card:focus-visible) {
      transform: rotate(-3deg) translate(-8px, 6px) scale(1.02);
    }

    .grid.is-messy :global(.app-showcase__slide:nth-child(2) .app-card:hover),
    .grid.is-messy :global(.app-showcase__slide:nth-child(2) .app-card:focus-visible) {
      transform: rotate(2deg) translate(0, -6px) scale(1.02);
    }

    .grid.is-messy :global(.app-showcase__slide:nth-child(3) .app-card:hover),
    .grid.is-messy :global(.app-showcase__slide:nth-child(3) .app-card:focus-visible) {
      transform: rotate(4deg) translate(8px, 4px) scale(1.02);
    }
  }

  .footer {
    margin-top: clamp(1rem, 3vw, 1.5rem);
    padding-top: 0.75rem;
    border-top: 1px solid var(--footer-border);
    font-size: 13px;
    color: var(--muted);
    text-align: center;
  }

  .footer a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .footer a:hover,
  .footer a:focus-visible {
    color: var(--text);
  }

  .footer a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }
</style>

<script is:inline>
  (function tmHoldingEggs() {
    var mqReduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var dinky = document.querySelector('[data-app="dinky"]');
    var binky = document.querySelector('[data-app="binky"]');
    var grid = document.querySelector('.grid');
    var toastSlot = document.getElementById('toast-slot');
    var tmBg = document.getElementById('tm-bg');
    var page = document.querySelector('.page');

    function setBgAccent(slug) {
      if (!tmBg) return;
      if (!slug) {
        tmBg.removeAttribute('data-accent');
        return;
      }
      tmBg.setAttribute('data-accent', slug);
    }

    if (grid && tmBg) {
      grid.addEventListener('pointerover', function (e) {
        var card = e.target.closest && e.target.closest('.app-card');
        if (!card || !grid.contains(card)) return;
        setBgAccent(card.getAttribute('data-app'));
      });
      grid.addEventListener('pointerout', function (e) {
        var rel = e.relatedTarget;
        if (rel && grid.contains(rel)) return;
        setBgAccent(null);
      });
      grid.addEventListener('focusin', function (e) {
        var card = e.target.closest && e.target.closest('.app-card');
        if (!card || !grid.contains(card)) return;
        setBgAccent(card.getAttribute('data-app'));
      });
      grid.addEventListener('focusout', function (e) {
        var rel = e.relatedTarget;
        if (rel && grid.contains(rel)) return;
        setBgAccent(null);
      });
    }

    var toastHideTimer = null;

    function fadeOutRemoveToast(el) {
      if (!el || !el.parentNode) return;
      if (toastHideTimer !== null) {
        window.clearTimeout(toastHideTimer);
        toastHideTimer = null;
      }
      el.classList.remove('is-visible');
      window.setTimeout(function () {
        if (el.parentNode) el.remove();
      }, 380);
    }

    function dismissToastImmediately(el) {
      if (toastHideTimer !== null) {
        window.clearTimeout(toastHideTimer);
        toastHideTimer = null;
      }
      if (el && el.parentNode) el.remove();
    }

    function dismissSelectionToastOnly() {
      if (!toastSlot) return;
      var t = toastSlot.querySelector('.tm-toast[data-toast-src="selection"]');
      if (t) dismissToastImmediately(t);
    }

    function showToast(spec) {
      if (!toastSlot) return;
      var prev = toastSlot.querySelector('.tm-toast');
      if (prev) dismissToastImmediately(prev);

      var a = document.createElement('a');
      a.className = 'tm-toast';
      a.href = spec.href;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = spec.message;
      a.setAttribute('role', 'status');
      a.setAttribute('aria-live', 'polite');
      if (spec.source) a.setAttribute('data-toast-src', spec.source);

      toastSlot.appendChild(a);
      window.requestAnimationFrame(function () {
        a.classList.add('is-visible');
      });

      toastHideTimer = window.setTimeout(function () {
        toastHideTimer = null;
        fadeOutRemoveToast(a);
      }, spec.durationMs != null ? spec.durationMs : 4500);

      a.addEventListener('click', function () {
        if (toastHideTimer !== null) {
          window.clearTimeout(toastHideTimer);
          toastHideTimer = null;
        }
      });
    }

    function hasFilePayload(dt) {
      if (!dt || !dt.types) return false;
      for (var i = 0; i < dt.types.length; i++) {
        if (dt.types[i] === 'Files') return true;
      }
      return false;
    }

    function clearFileDropTargets() {
      if (dinky) dinky.classList.remove('is-drop-target');
      if (binky) binky.classList.remove('is-drop-target');
    }

    if (toastSlot && (dinky || binky)) {
      document.addEventListener(
        'dragover',
        function (e) {
          if (!hasFilePayload(e.dataTransfer)) return;
          e.preventDefault();
          e.dataTransfer.dropEffect = 'copy';
          var el = document.elementFromPoint(e.clientX, e.clientY);
          var card = el && el.closest && el.closest('.app-card');
          clearFileDropTargets();
          if (dinky && card === dinky) dinky.classList.add('is-drop-target');
          else if (binky && card === binky) binky.classList.add('is-drop-target');
        },
        { passive: false },
      );

      document.addEventListener('dragend', clearFileDropTargets);

      document.addEventListener('drop', function (e) {
        clearFileDropTargets();
        if (!hasFilePayload(e.dataTransfer)) return;

        var onDinky = dinky && e.target && dinky.contains(e.target);
        var onBinky = binky && e.target && binky.contains(e.target);

        if (onDinky) {
          e.preventDefault();
          var nD = e.dataTransfer.files ? e.dataTransfer.files.length : 0;
          if (nD <= 0) return;
          showToast({
            message:
              nD === 1
                ? 'Want to actually shrink that? Try Dinky — dinkyfiles.com'
                : 'Want to actually shrink those? Try Dinky — dinkyfiles.com',
            href: 'https://dinkyfiles.com/',
            source: 'drop-dinky',
            durationMs: 4500,
          });
          return;
        }

        if (onBinky) {
          e.preventDefault();
          var nB = e.dataTransfer.files ? e.dataTransfer.files.length : 0;
          if (nB <= 0) return;
          showToast({
            message:
              nB === 1
                ? 'Want that sorted for you? Try Binky — binkyfiles.com'
                : 'Want those sorted for you? Try Binky — binkyfiles.com',
            href: 'https://binkyfiles.com/',
            source: 'drop-binky',
            durationMs: 4500,
          });
        }
      });
    }
    var messyTimer = 0;
    if (grid && binky && !mqReduce.matches) {
      binky.addEventListener('pointerenter', function () {
        window.clearTimeout(messyTimer);
        grid.classList.add('is-messy');
      });
      binky.addEventListener('pointerleave', function () {
        messyTimer = window.setTimeout(function () {
          grid.classList.remove('is-messy');
        }, 150);
      });
    }

    var selRaf = 0;
    var lastSelectionText = '';

    function selInPage(sel) {
      if (!sel || sel.rangeCount === 0 || !page) return false;
      var node = sel.anchorNode;
      if (!node || node.nodeType === 9) return false;
      return page.contains(node);
    }

    function updateSelectionToast() {
      if (!toastSlot || !page) return;
      var sel = window.getSelection();
      var txt = sel ? sel.toString().trim() : '';
      if (!txt || !sel || !selInPage(sel)) {
        lastSelectionText = '';
        dismissSelectionToastOnly();
        return;
      }
      if (txt === lastSelectionText) return;
      lastSelectionText = txt;

      showToast({
        message: 'Save this in Harvous — harvous.com',
        href: 'https://harvous.com/',
        source: 'selection',
        durationMs: 4500,
      });
    }

    document.addEventListener('selectionchange', function () {
      window.cancelAnimationFrame(selRaf);
      selRaf = window.requestAnimationFrame(updateSelectionToast);
    });

    window.addEventListener(
      'scroll',
      function () {
        lastSelectionText = '';
        dismissSelectionToastOnly();
      },
      true,
    );

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        lastSelectionText = '';
        dismissSelectionToastOnly();
      }
    });
  })();
</script>

<script is:inline>
  (function tmAppCarousel() {
    var mqCarousel = window.matchMedia('(max-width: 51.99rem)');
    var mqReduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    /** Touch taps fire pointerenter; only pause autoplay for mouse/trackpad hover */
    var mqFineHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    var viewport = document.getElementById('app-showcase-viewport');
    var prevBtn = document.getElementById('app-showcase-prev');
    var nextBtn = document.getElementById('app-showcase-next');
    var showcase = document.querySelector('.app-showcase');
    if (!viewport || !prevBtn || !nextBtn || !showcase) return;

    function slides() {
      return viewport.querySelectorAll('.app-showcase__slide');
    }

    function nearestIndex() {
      var list = slides();
      if (!list.length) return 0;
      var x = viewport.scrollLeft;
      var best = 0;
      var bestDist = Infinity;
      for (var i = 0; i < list.length; i++) {
        var d = Math.abs(list[i].offsetLeft - x);
        if (d < bestDist) {
          bestDist = d;
          best = i;
        }
      }
      return best;
    }

    function scrollToIndex(i, smooth) {
      var list = slides();
      if (!list.length) return;
      var clamped = Math.max(0, Math.min(list.length - 1, i));
      var el = list[clamped];
      var useSmooth = smooth !== false && !mqReduce.matches;
      viewport.scrollTo({
        left: el.offsetLeft,
        behavior: useSmooth ? 'smooth' : 'auto',
      });
    }

    var lastCarouselIdx = -1;

    function restartActiveDotProgress() {
      if (mqReduce.matches) return;
      var p = showcase.querySelector('.app-showcase__dot.is-active .app-showcase__dot-progress');
      if (!p) return;
      p.style.animation = 'none';
      void p.offsetWidth;
      p.style.removeProperty('animation');
    }

    function updateUI() {
      if (!mqCarousel.matches) return;
      var idx = nearestIndex();
      var list = slides();
      var last = list.length - 1;
      prevBtn.disabled = idx <= 0;
      nextBtn.disabled = idx >= last;
      var dots = showcase.querySelectorAll('.app-showcase__dot');
      var idxChanged = idx !== lastCarouselIdx;
      for (var d = 0; d < dots.length; d++) {
        var on = d === idx;
        dots[d].classList.toggle('is-active', on);
        if (on) dots[d].setAttribute('aria-current', 'true');
        else dots[d].removeAttribute('aria-current');
      }
      if (idxChanged) {
        lastCarouselIdx = idx;
        restartActiveDotProgress();
      }
    }

    var autoTimer = null;
    /** Keep equal to `.app-showcase { --carousel-autoplay-ms }` in CSS */
    var AUTOPLAY_MS = 6000;

    function stopAuto() {
      if (autoTimer !== null) {
        window.clearInterval(autoTimer);
        autoTimer = null;
      }
    }

    function startAuto() {
      stopAuto();
      if (!mqCarousel.matches || mqReduce.matches) return;
      autoTimer = window.setInterval(function () {
        var list = slides();
        if (list.length < 2) return;
        var idx = nearestIndex();
        var next = (idx + 1) % list.length;
        scrollToIndex(next, true);
      }, AUTOPLAY_MS);
    }

    var scrollIdle = null;
    function onScroll() {
      window.requestAnimationFrame(updateUI);
      if (scrollIdle !== null) window.clearTimeout(scrollIdle);
      scrollIdle = window.setTimeout(function () {
        scrollIdle = null;
        updateUI();
      }, 100);
    }

    prevBtn.addEventListener('click', function () {
      scrollToIndex(nearestIndex() - 1, true);
    });
    nextBtn.addEventListener('click', function () {
      scrollToIndex(nearestIndex() + 1, true);
    });

    var dots = showcase.querySelectorAll('.app-showcase__dot');
    for (var i = 0; i < dots.length; i++) {
      dots[i].addEventListener('click', (function (slide) {
        return function () {
          scrollToIndex(slide, true);
        };
      })(i));
    }

    viewport.addEventListener('scroll', onScroll, { passive: true });
    viewport.addEventListener('scrollend', updateUI);

    showcase.addEventListener('pointerenter', function () {
      if (!mqFineHover.matches) return;
      stopAuto();
      showcase.classList.add('app-showcase--carousel-paused');
    });
    showcase.addEventListener('pointerleave', function (e) {
      if (!mqFineHover.matches) return;
      if (e.relatedTarget && showcase.contains(e.relatedTarget)) return;
      showcase.classList.remove('app-showcase--carousel-paused');
      if (mqCarousel.matches) {
        restartActiveDotProgress();
        startAuto();
      }
    });

    viewport.addEventListener('keydown', function (e) {
      if (!mqCarousel.matches) return;
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        scrollToIndex(nearestIndex() - 1, true);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        scrollToIndex(nearestIndex() + 1, true);
      }
    });

    function onMqChange() {
      stopAuto();
      showcase.classList.remove('app-showcase--carousel-paused');
      if (!mqCarousel.matches) {
        viewport.scrollLeft = 0;
        lastCarouselIdx = -1;
      } else {
        lastCarouselIdx = -1;
        window.requestAnimationFrame(function () {
          updateUI();
          startAuto();
        });
      }
      updateUI();
    }

    if (typeof mqCarousel.addEventListener === 'function') {
      mqCarousel.addEventListener('change', onMqChange);
    } else {
      mqCarousel.addListener(onMqChange);
    }

    window.addEventListener('load', function () {
      updateUI();
      if (mqCarousel.matches) startAuto();
    });
    updateUI();
    if (mqCarousel.matches) startAuto();
  })();
</script>

<script is:inline>
  (function tmAuthorHitTouch() {
    var hit = document.getElementById('author-hit');
    var nameEl = document.querySelector('.author-hit__name');
    var mq = window.matchMedia('(hover: none)');
    if (!hit || !nameEl) return;

    function setOpen(on) {
      hit.classList.toggle('is-about-open', on);
      hit.setAttribute('aria-expanded', on ? 'true' : 'false');
    }

    nameEl.addEventListener('click', function (e) {
      if (!mq.matches) return;
      e.stopPropagation();
      setOpen(!hit.classList.contains('is-about-open'));
    });

    document.addEventListener(
      'click',
      function (e) {
        if (!mq.matches) return;
        if (!hit.contains(e.target)) setOpen(false);
      },
      true,
    );

    function onMqChange() {
      if (!mq.matches) setOpen(false);
    }

    if (typeof mq.addEventListener === 'function') mq.addEventListener('change', onMqChange);
    else mq.addListener(onMqChange);
  })();
</script>

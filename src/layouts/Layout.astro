---
type Props = {
  title?: string;
  description?: string;
  /** Same-origin image URLs to start fetching before the body parses (pairs with long-lived Cache-Control). */
  preloadImages?: string[];
};

const {
  title = 'Testament Made',
  description = 'Apps from Testament Made LLC — Dinky, Binky, and Harvous.',
  preloadImages = [],
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafafa" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {preloadImages.map((href) => (
      <link rel="preload" href={href} as="image" />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafafa;
    --text: #1a1a1a;
    --muted: #737373;
    --card-bg: #f5f5f5;
    --accent: #2563eb;
    --max: 72rem;
    font-family:
      'Plus Jakarta Sans',
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    color: var(--text);
    background: var(--bg);
    line-height: 1.5;
  }
</style>

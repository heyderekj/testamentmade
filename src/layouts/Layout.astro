---
type Props = {
  title?: string;
  description?: string;
  /** Path from site root for og:image / twitter:image (default: /og.png). */
  image?: string;
  /** Same-origin image URLs to start fetching before the body parses (pairs with long-lived Cache-Control). */
  preloadImages?: string[];
};

const {
  title = 'Testament Made',
  description = 'Small apps from Testament Made LLC — Harvous, Here’s My Church, ReviseMy, Koati, Dinky, and Binky.',
  image = '/og.png',
  preloadImages = [],
} = Astro.props;

const imagePath = image.startsWith('/') ? image : `/${image}`;
const pageUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : new URL(Astro.url.pathname, Astro.url).href;
const ogImageUrl = Astro.site
  ? new URL(imagePath, Astro.site).href
  : new URL(imagePath, Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Testament Made, a small independent app studio by Derek Castelli, with the icons for Harvous, Here’s My Church, ReviseMy, Koati, Dinky and Binky." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191816" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-2.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {preloadImages.map((href) => (
      <link rel="preload" href={href} as="image" />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <!-- Fathom - beautiful, simple website analytics -->
    <script src="https://cdn.usefathom.com/script.js" data-site="YOHJPTEN" defer></script>
    <!-- / Fathom -->
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Warm paper and ink, shared with the apps' own sites (Koati, ReviseMy) */
  :root {
    color-scheme: light dark;

    --bg: #faf9f7;
    --text: #161513;
    --text-soft: #3d3a35;
    --muted: #6c6760;
    --card-bg: #fdfcfa;
    --accent: #161513;
    --max: 80rem;

    --border-subtle: #e3e0da;
    --border-strong: #cdc9c1;
    --shadow-soft: rgb(22 21 19 / 0.08);
    --shadow-deep: rgb(22 21 19 / 0.15);

    --card-shadow-1: rgb(22 21 19 / 0.04);
    --card-shadow-2: rgb(22 21 19 / 0.08);
    --card-shadow-hover-1: rgb(22 21 19 / 0.06);
    --card-shadow-hover-2: rgb(22 21 19 / 0.2);

    --surface-elevated: #ffffff;

    font-family:
      'Figtree',
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #191816;
      --text: #f6f4f0;
      --text-soft: #d9d5ce;
      --muted: #a29c93;
      --card-bg: #23211e;
      --accent: #f6f4f0;

      --border-subtle: rgb(255 255 255 / 0.09);
      --border-strong: rgb(255 255 255 / 0.18);
      --shadow-soft: rgb(0 0 0 / 0.42);
      --shadow-deep: rgb(0 0 0 / 0.58);

      --card-shadow-1: rgb(0 0 0 / 0.5);
      --card-shadow-2: rgb(0 0 0 / 0.4);
      --card-shadow-hover-1: rgb(0 0 0 / 0.6);
      --card-shadow-hover-2: rgb(0 0 0 / 0.5);

      --surface-elevated: #2c2a26;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    min-height: 100dvh;
    color: var(--text);
    background: var(--bg);
    line-height: 1.5;
  }

</style>

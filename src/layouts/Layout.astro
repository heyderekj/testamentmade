---
type Props = {
  title?: string;
  description?: string;
  /** Same-origin image URLs to start fetching before the body parses (pairs with long-lived Cache-Control). */
  preloadImages?: string[];
};

const {
  title = 'Testament Made',
  description = 'Apps from Testament Made LLC — Harvous, Dinky, and Binky.',
  preloadImages = [],
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f9fc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d111c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {preloadImages.map((href) => (
      <link rel="preload" href={href} as="image" />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* OKLCH tokens — perceptually even neutrals & brand blobs (same hue ladder ~264–279) */
  :root {
    color-scheme: light dark;

    --bg: oklch(0.986 0.003 264);
    --text: oklch(0.216 0.012 264);
    --muted: oklch(0.545 0.018 267);
    --card-bg: oklch(0.962 0.005 263);
    --accent: oklch(0.528 0.196 267);
    --max: 72rem;

    /* Surfaces / chrome */
    --surface-elevated: oklch(0.999 0.002 264);
    --border-subtle: oklch(0.265 0.042 265 / 0.1);
    --border-strong: oklch(0.265 0.042 265 / 0.15);
    --shadow-soft: oklch(0.265 0.042 265 / 0.08);
    --shadow-deep: oklch(0.265 0.042 265 / 0.15);
    --footer-border: oklch(0.265 0.042 265 / 0.07);

    --card-shadow-1: oklch(0.265 0.042 265 / 0.05);
    --card-shadow-2: oklch(0.265 0.042 265 / 0.085);
    --card-shadow-hover-1: oklch(0.265 0.042 265 / 0.1);
    --card-shadow-hover-2: oklch(0.265 0.042 265 / 0.14);

    --icon-drop-shadow: oklch(0.265 0.042 265 / 0.16);

    --focus-ring-gap: oklch(0.986 0.003 264);

    /* Ambient blobs — brand chroma, alpha in gradient color */
    --blob-pink: oklch(0.591 0.242 356 / 0.9);
    --blob-indigo: oklch(0.485 0.208 279 / 0.87);
    --blob-blue: oklch(0.662 0.172 246 / 0.88);

    --blob-accent-opacity: 0.52;
    --blob-idle-opacity: 0.28;

    font-family:
      'Plus Jakarta Sans',
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: oklch(0.175 0.03 267);
      --text: oklch(0.965 0.007 274);
      --muted: oklch(0.705 0.02 274);
      --card-bg: oklch(0.23 0.035 267);
      --accent: oklch(0.715 0.148 259);

      --surface-elevated: oklch(0.275 0.036 267);
      --border-subtle: oklch(1 0.006 274 / 0.1);
      --border-strong: oklch(1 0.006 274 / 0.14);
      --shadow-soft: oklch(0 0 0 / 0.42);
      --shadow-deep: oklch(0 0 0 / 0.58);
      --footer-border: oklch(1 0.006 274 / 0.09);

      --card-shadow-1: oklch(0 0 0 / 0.52);
      --card-shadow-2: oklch(0 0 0 / 0.42);
      --card-shadow-hover-1: oklch(0 0 0 / 0.6);
      --card-shadow-hover-2: oklch(0 0 0 / 0.38);

      --icon-drop-shadow: oklch(0 0 0 / 0.56);

      --focus-ring-gap: oklch(0.175 0.03 267);

      /* Softer blobs on dark canvas */
      --blob-pink: oklch(0.695 0.13 356 / 0.44);
      --blob-indigo: oklch(0.628 0.14 279 / 0.4);
      --blob-blue: oklch(0.695 0.12 246 / 0.42);

      --blob-accent-opacity: 0.7;
      --blob-idle-opacity: 0.2;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    /* Wide blurred orbs must not widen document scroll width */
    overflow-x: clip;
  }

  body {
    margin: 0;
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    overflow-x: clip;
    color: var(--text);
    background: var(--bg);
    line-height: 1.5;
  }

  .tm-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Blur + large drift extend far past inset; paint containment also clips */
    overflow: visible;
  }

  .tm-bg__blob {
    position: absolute;
    width: min(120vmin, 58rem);
    height: min(120vmin, 58rem);
    border-radius: 50%;
    filter: blur(60px);
    will-change: transform;
    opacity: var(--blob-idle-opacity);
    transition: opacity 0.45s ease;
  }

  @keyframes tm-drift-aurora {
    0%,
    100% {
      transform: translate3d(-6vmin, 2vmin, 0) rotate(-1.8deg);
    }
    22% {
      transform: translate3d(10vmin, -5vmin, 0) rotate(1.2deg);
    }
    44% {
      transform: translate3d(5vmin, 11vmin, 0) rotate(2.3deg);
    }
    66% {
      transform: translate3d(-11vmin, -4vmin, 0) rotate(-1deg);
    }
    85% {
      transform: translate3d(7vmin, 6vmin, 0) rotate(0.6deg);
    }
  }

  @keyframes tm-drift-nebula {
    0%,
    100% {
      transform: translate3d(4vmin, -3vmin, 0) rotate(1.1deg);
    }
    18% {
      transform: translate3d(-9vmin, 6vmin, 0) rotate(-2.4deg);
    }
    38% {
      transform: translate3d(8vmin, 9vmin, 0) rotate(0.4deg);
    }
    58% {
      transform: translate3d(-5vmin, -8vmin, 0) rotate(2deg);
    }
    78% {
      transform: translate3d(11vmin, 2vmin, 0) rotate(-1.2deg);
    }
  }

  @keyframes tm-drift-tide {
    0%,
    100% {
      transform: translate3d(3vmin, 5vmin, 0) rotate(0deg);
    }
    14% {
      transform: translate3d(-12vmin, -4vmin, 0) rotate(-2.5deg);
    }
    35% {
      transform: translate3d(9vmin, -7vmin, 0) rotate(1.5deg);
    }
    56% {
      transform: translate3d(-4vmin, 12vmin, 0) rotate(-0.8deg);
    }
    76% {
      transform: translate3d(10vmin, 4vmin, 0) rotate(2.2deg);
    }
    92% {
      transform: translate3d(-8vmin, -6vmin, 0) rotate(-1.4deg);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tm-bg__blob--pink {
      animation: tm-drift-aurora 21s cubic-bezier(0.45, 0.03, 0.55, 0.97) -4s infinite;
    }

    .tm-bg__blob--indigo {
      animation: tm-drift-nebula 29s cubic-bezier(0.37, 0, 0.63, 1) -9s infinite;
    }

    .tm-bg__blob--blue {
      animation: tm-drift-tide 18s cubic-bezier(0.32, 0.11, 0.67, 0.89) -2s infinite;
    }
  }

  .tm-bg__blob--pink {
    right: -12%;
    top: 5%;
    left: auto;
    background: radial-gradient(
      circle closest-side at 50% 50%,
      var(--blob-pink),
      transparent 72%
    );
  }

  .tm-bg__blob--indigo {
    left: 25%;
    top: 12%;
    background: radial-gradient(
      circle closest-side at 50% 50%,
      var(--blob-indigo),
      transparent 70%
    );
  }

  .tm-bg__blob--blue {
    left: -15%;
    top: -5%;
    right: auto;
    background: radial-gradient(
      circle closest-side at 50% 50%,
      var(--blob-blue),
      transparent 68%
    );
  }

  /* Hover an app card: only that orb reads at full warmth */
  .tm-bg[data-accent='binky'] .tm-bg__blob--pink {
    opacity: var(--blob-accent-opacity);
    z-index: 1;
  }

  .tm-bg[data-accent='dinky'] .tm-bg__blob--indigo {
    opacity: var(--blob-accent-opacity);
    z-index: 1;
  }

  .tm-bg[data-accent='harvous'] .tm-bg__blob--blue {
    opacity: var(--blob-accent-opacity);
    z-index: 1;
  }

  .tm-bg[data-accent='binky'] .tm-bg__blob--indigo,
  .tm-bg[data-accent='binky'] .tm-bg__blob--blue {
    opacity: 0;
    animation: none;
  }

  .tm-bg[data-accent='dinky'] .tm-bg__blob--pink,
  .tm-bg[data-accent='dinky'] .tm-bg__blob--blue {
    opacity: 0;
    animation: none;
  }

  .tm-bg[data-accent='harvous'] .tm-bg__blob--pink,
  .tm-bg[data-accent='harvous'] .tm-bg__blob--indigo {
    opacity: 0;
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .tm-bg__blob {
      animation: none !important;
    }
  }

  .tm-toast {
    box-sizing: border-box;
    width: fit-content;
    max-width: min(22rem, calc(100vw - 2rem));
    transform: translateY(6px);
    padding: 0.85rem 1.1rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
    background: var(--surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 0.875rem;
    box-shadow:
      0 2px 8px var(--shadow-soft),
      0 12px 32px var(--shadow-deep);
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.35s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tm-toast.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
</style>

---
import CoreValueHeroicon from './CoreValueHeroicon.astro';
import { coreValues } from '../data/core-values';
---

<section class="tm-dinky-core-values">
  <div class="tm-core-values-grid">
    {
      coreValues.map((item) => (
        <div class="tm-core-values__item">
          <CoreValueHeroicon name={item.icon} />
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Feature typography aligned with dinkyfiles.com `.ss-card-feature`; no outer card surface */
  .tm-dinky-core-values {
    --dinky-text: var(--text);
    --dinky-text-secondary: var(--muted);
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding-top: clamp(1rem, 3vw, 1.5rem);
  }

  /* Same content width as hero `.heading` on desktop (see index.astro 52rem) */
  @media (min-width: 52rem) {
    .tm-dinky-core-values {
      max-width: min(820px, 100%);
    }
  }

  .tm-dinky-core-values .tm-core-values-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(14px, 3.5vw, 18px) clamp(16px, 4vw, 24px);
  }

  @media (min-width: 960px) {
    .tm-dinky-core-values .tm-core-values-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px 28px;
    }
  }

  .tm-dinky-core-values .tm-core-values__item :global(svg.feature-icon) {
    width: 20px;
    height: 20px;
    margin-bottom: 6px;
    display: block;
    color: var(--dinky-text);
    flex-shrink: 0;
  }

  .tm-dinky-core-values .tm-core-values__item h3 {
    margin: 0 0 4px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--dinky-text);
  }

  .tm-dinky-core-values .tm-core-values__item p {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--dinky-text-secondary);
  }
</style>

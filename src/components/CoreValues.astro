---
import CoreValueHeroicon from './CoreValueHeroicon.astro';
import { coreValues } from '../data/core-values';

const headingId = 'core-values-heading';
---

<section class="tm-dinky-core-values" aria-labelledby={headingId}>
  <h2 class="tm-dinky-core-values__title" id={headingId}>What we stand for</h2>
  <div class="tm-core-values-grid">
    {
      coreValues.map((item) => (
        <div class="tm-core-values__item">
          <CoreValueHeroicon name={item.icon} />
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Feature typography aligned with dinkyfiles.com `.ss-card-feature`; no outer card surface */
  .tm-dinky-core-values {
    --dinky-text: var(--text);
    --dinky-text-secondary: var(--muted);
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding-top: clamp(0.5rem, 2vw, 1rem);
  }

  .tm-dinky-core-values__title {
    margin: 0 0 clamp(20px, 3vw, 24px);
    text-align: center;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--dinky-text);
  }

  .tm-dinky-core-values .tm-core-values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  @media (min-width: 520px) {
    .tm-dinky-core-values .tm-core-values-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px 28px;
    }
  }

  @media (min-width: 960px) {
    .tm-dinky-core-values .tm-core-values-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px 28px;
    }
  }

  .tm-dinky-core-values .tm-core-values__item :global(svg.feature-icon) {
    width: 20px;
    height: 20px;
    margin-bottom: 6px;
    display: block;
    color: var(--dinky-text);
    flex-shrink: 0;
  }

  .tm-dinky-core-values .tm-core-values__item h3 {
    margin: 0 0 4px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--dinky-text);
  }

  .tm-dinky-core-values .tm-core-values__item p {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--dinky-text-secondary);
  }
</style>

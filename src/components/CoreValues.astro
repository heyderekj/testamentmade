---
import { coreValues } from '../data/core-values';

const headingId = 'core-values-heading';
---

<section class="core-values" aria-labelledby={headingId}>
  <h2 class="core-values__heading" id={headingId}>What we stand for</h2>
  <div class="core-values__grid">
    {coreValues.map((item, index) => (
      <article class="core-values__card" style={{ '--stagger': index }}>
        <div class="core-values__media" aria-hidden="true">
          <img
            class="core-values__icon"
            src={item.iconSrc}
            alt=""
            width="64"
            height="64"
            loading="lazy"
            decoding="async"
          />
        </div>
        <h3 class="core-values__title">{item.title}</h3>
        <p class="core-values__description">{item.description}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .core-values {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 3vw, 1.75rem);
    padding-top: clamp(0.5rem, 2vw, 1rem);
  }

  .core-values__heading {
    margin: 0;
    text-align: center;
    font-weight: 600;
    font-size: clamp(1.15rem, 2.5vw, 1.35rem);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .core-values__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-items: stretch;
  }

  @media (min-width: 36rem) {
    .core-values__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .core-values__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .core-values__card {
    --radius: clamp(1.1rem, 2.5vw, 1.5rem);
    margin: 0;
    padding: 1.35rem 1.35rem 1.2rem;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    background: var(--card-bg);
    border-radius: var(--radius);
    border: 1px solid var(--border-subtle);
    box-shadow:
      0 1px 2px var(--card-shadow-1),
      0 8px 24px var(--card-shadow-2);
    transform-origin: center;
    transition:
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.28s ease;
    animation: core-value-in 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--stagger) * 60ms);
  }

  .core-values__media {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 4.25rem;
  }

  .core-values__icon {
    width: clamp(3.25rem, 12vw, 4rem);
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    filter: drop-shadow(0 10px 22px var(--icon-drop-shadow));
  }

  @media (prefers-reduced-motion: no-preference) {
    .core-values__card:hover {
      transform: scale(1.015);
      box-shadow:
        0 2px 8px var(--card-shadow-hover-1),
        0 16px 40px var(--card-shadow-hover-2);
      border-color: var(--border-strong);
    }
  }

  .core-values__title {
    margin: 0;
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--text);
  }

  .core-values__description {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--muted);
  }

  @keyframes core-value-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .core-values__card {
      animation: none;
      opacity: 1;
      transform: none;
      transition: none;
    }

    .core-values__card:hover {
      transform: none;
    }
  }
</style>

---
import type { AppEntry } from '../data/apps';

type Props = AppEntry & { index: number };

const { title, tags, href, iconSrc, linkLabel, slug, index } = Astro.props;
const tagLine = tags.join(' · ');
---

<a
  class="app-card"
  id={`card-${slug}`}
  data-app={slug}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  style={{ '--stagger': index }}
>
  <span class="app-card__media" aria-hidden="true">
    <img
      class="app-card__icon"
      src={iconSrc}
      alt=""
      width="120"
      height="120"
      loading={index === 0 ? 'eager' : 'lazy'}
      decoding="async"
      {...(index === 0 ? { fetchpriority: 'high' } : {})}
    />
  </span>
  <span class="app-card__footer">
    <span class="app-card__meta">
      <span class="app-card__title">{title}</span>
      <span class="app-card__tags">{tagLine}</span>
    </span>
    <span class="app-card__label">{linkLabel}</span>
  </span>
</a>

<style>
  .app-card {
    --radius: clamp(1.25rem, 3vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem 1.5rem 1.25rem;
    min-height: 100%;
    text-decoration: none;
    color: inherit;
    background: var(--card-bg);
    border-radius: var(--radius);
    box-shadow:
      0 1px 2px var(--card-shadow-1),
      0 8px 24px var(--card-shadow-2);
    border: 1px solid var(--border-subtle);
    transform-origin: center;
    transition:
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.28s ease;
    animation: card-in 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--stagger) * 85ms);
  }

  .app-card:hover,
  .app-card:focus-visible {
    transform: scale(1.02);
    box-shadow:
      0 2px 8px var(--card-shadow-hover-1),
      0 16px 40px var(--card-shadow-hover-2);
    border-color: var(--border-strong);
  }

  .app-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .app-card__media {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 9rem;
  }

  .app-card__icon {
    width: clamp(5rem, 28vw, 7.5rem);
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: 22%;
    filter: drop-shadow(0 12px 28px var(--icon-drop-shadow));
  }

  .app-card__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .app-card__meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .app-card__title {
    font-weight: 600;
    font-size: 1.08rem;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .app-card__tags {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .app-card__label {
    flex-shrink: 0;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted);
  }

  .app-card.is-drop-target {
    outline: 2px dashed var(--accent);
    outline-offset: 4px;
    border-radius: inherit;
    background: color-mix(in oklch, var(--accent) 14%, var(--card-bg));
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-card {
      animation: none;
      opacity: 1;
      transform: none;
      transition: none;
    }

    .app-card:hover,
    .app-card:focus-visible {
      transform: none;
    }
  }
</style>
